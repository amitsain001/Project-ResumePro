<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="/CSS/style.css" >

<%- include ("../includes/navbar.ejs") %>  <!-- navbar ejs file -->

<div class="flashcontainer">
    <%- include ("../includes/flash.ejs") %>  <!-- flash ejs file --> 
</div>

<div class="container mt-5">
  <div class="card shadow-lg p-4">
        <h2 class="text-center mb-4">🚀 ATS Resume Checker</h2>

        <form action="/api/ats/check-ats" method="POST" enctype="multipart/form-data">
        
            <!-- Job Description -->
            <div class="mb-3">
                <label class="form-label">Job Description</label>
                <textarea name="jobDescription" class="form-control" rows="6" placeholder="Paste job description here..." required></textarea>
            </div>

            <!-- Resume Upload -->
            <div class="mb-3">
                <label class="form-label">Upload Resume (PDF/DOCX)</label>
                <input type="file" name="resume" class="form-control" required />
            </div>

            <button class="btn btn-primary w-100">Check ATS Score</button>
        </form>
  </div>
</div>

<%- include ("../includes/footer.ejs") %>  <!-- navbar ejs file -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script src="../js/script.js" ></script>