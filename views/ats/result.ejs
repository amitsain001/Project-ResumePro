<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="/CSS/style.css" >

<%- include ("../includes/navbar.ejs") %>  <!-- navbar ejs file -->

<div class="flashcontainer">
    <%- include ("../includes/flash.ejs") %>  <!-- flash ejs file --> 
</div>

<div class="container mt-5">

  <!-- SCORE CARD -->
  <div class="card text-center shadow-lg p-4 mb-4">
    <h2>ATS Score</h2>
    <h1 style="font-size: 60px; color: #007bff;">
      <%= result.score %>%
    </h1>

    <div class="progress mt-3">
      <div class="progress-bar" 
           style="width: <%= result.score %>%;">
      </div>
    </div>
  </div>

  <!-- GRID SECTION -->
  <div class="row">

    <!-- Missing Keywords -->
    <div class="col-md-6">
      <div class="card p-3 shadow-sm mb-4">
        <h4>❌ Missing Keywords</h4>
        <ul>
          <% result.missing_keywords.forEach(k => { %>
            <li><%= k %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <!-- Strengths -->
    <div class="col-md-6">
      <div class="card p-3 shadow-sm mb-4">
        <h4>✅ Strengths</h4>
        <ul>
          <% result.strengths.forEach(s => { %>
            <li><%= s %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <!-- Weaknesses -->
    <div class="col-md-6">
      <div class="card p-3 shadow-sm mb-4">
        <h4>⚠️ Weaknesses</h4>
        <ul>
          <% result.weaknesses.forEach(w => { %>
            <li><%= w %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <!-- Suggestions -->
    <div class="col-md-6">
      <div class="card p-3 shadow-sm mb-4">
        <h4>💡 Suggestions</h4>
        <ul>
          <% result.suggestions.forEach(s => { %>
            <li><%= s %></li>
          <% }) %>
        </ul>
      </div>
    </div>

  </div>

  <!-- BACK BUTTON -->
  <div class="text-center mt-3">
    <a href="/api/ats" class="btn btn-secondary">🔙 Check Another Resume</a>
  </div>

</div>